<!-- Step 1: drag two small images into the project: img1.jpg and img2.jpg (online links do not work offline) -->

<!-- ===== ads.xml : Add > New Item > XML File, replace everything in it with this ===== -->
<?xml version="1.0" encoding="utf-8" ?>
<Advertisements>
  <Ad>
    <ImageUrl>~/img1.jpg</ImageUrl>
    <NavigateUrl>https://www.dove.com</NavigateUrl>
    <AlternateText>Dove Soap</AlternateText>
  </Ad>
  <Ad>
    <ImageUrl>~/img2.jpg</ImageUrl>
    <NavigateUrl>https://www.jiomart.com</NavigateUrl>
    <AlternateText>Cinthol Soap</AlternateText>
  </Ad>
</Advertisements>

<%-- ===== .aspx : paste inside <form>, in place of the <div>. ScriptManager must be first ===== --%>
<asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>
<asp:Timer ID="Timer1" runat="server" Interval="2000"></asp:Timer>
<asp:UpdatePanel ID="UpdatePanel1" runat="server">
    <Triggers>
        <asp:AsyncPostBackTrigger ControlID="Timer1" EventName="Tick" />
    </Triggers>
    <ContentTemplate>
        <asp:AdRotator ID="AdRotator1" runat="server" AdvertisementFile="~/ads.xml" Width="200px" Height="200px" />
    </ContentTemplate>
</asp:UpdatePanel>

<%-- No C# code needed. The ad changes every 2 seconds. --%>
